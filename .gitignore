# Clojure / JVM
.cpcache/
.clj-kondo/.cache/
.lsp/.cache/
target/
classes/
*.jar
*.class

# Generated by `clojure -Spom` and by tools.build. Remove this line if a
# hand-maintained pom.xml is ever checked in.
/pom.xml
/pom.xml.asc

# REPL
.nrepl-port
.rebel_readline_history
.cljs_node_repl/

# Leiningen, in case it is ever used
.lein-repl-history
.lein-deps-sum
.lein-failures
.lein-plugins/

# ClojureScript / npm — kept ahead of need only because committing
# node_modules by accident is expensive to undo, not because a frontend
# build has been chosen.
node_modules/
.shadow-cljs/
out/

# Secrets and local configuration. The system administrators' bootstrap
# file lives here: it must never reach the repository.
.env
.env.*
!.env.example
*.local.edn

# Browser-automation artefacts (Playwright MCP snapshots from smoke runs)
.playwright-mcp/

# Editors
.idea/
*.iml
.vscode/
.calva/output-window/
*~
\#*\#
.\#*

# macOS
.DS_Store

# The demos' own databases: each host names its own, and both are regenerated
# by booting. Written out rather than globbed, for the reason /safe-delete
# gives about `demo.db*`: a pattern that matches what must go also matches what
# must stay, and these sit beside the sources.
/demo.db
/demo.db-journal
/demo.db-wal
/demo.db-shm
/demo-tasks.db
/demo-tasks.db-journal
/demo-tasks.db-wal
/demo-tasks.db-shm
/demo-ledger.db
/demo-ledger.db-journal
/demo-ledger.db-wal
/demo-ledger.db-shm
/demo-events.db
/demo-events.db-journal
/demo-events.db-wal
/demo-events.db-shm
