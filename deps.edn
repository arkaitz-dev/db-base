{:paths ["src"]

 ;; SPEC §3: a consumer receives a pool and a migration runner, and nothing else.
 ;; Chosen 2026-09-11 from measurements, recorded in CLAUDE.md. HikariCP brings
 ;; slf4j-api, a facade that logs nowhere unless the host supplies a backend;
 ;; ragtime.next-jdbc brings next.jdbc, which db-base itself does not call.
 ;; `structure_test.clj` enforces what src/ may reach.
 ;; resauce is ragtime.sql's own resource reader, and src calls it directly to list the
 ;; prefix and refuse a file ragtime would pass over (§7), so it is declared rather than
 ;; taken transitively — the rule this file already applies to next.jdbc, from the other
 ;; side.
 :deps {org.clojure/clojure               {:mvn/version "1.12.5"}
        com.zaxxer/HikariCP               {:mvn/version "7.1.0"}
        dev.weavejester/ragtime.next-jdbc {:mvn/version "0.12.1"}
        resauce/resauce                   {:mvn/version "0.2.0"}
        ;; SPEC §10: Integrant is used, not imposed. Required only by
        ;; dev.arkaitz.db-base.integrant, which ships one key's init-key and halt-key!
        ;; for a host that wires with it — both of them, because Integrant's own
        ;; halt-key! default does nothing and says nothing; nothing else may load it,
        ;; and a scan enforces that,
        ;; because an illegal require compiles, loads and passes every other test.
        ;; Added 2026-09-20, when the first host asked for it — §12 forbids anything
        ;; entering the scope before that.
        integrant/integrant               {:mvn/version "1.0.1"}}

 :aliases
 ;; SPEC §3 is proven against two engines from different dialect families, one
 ;; strict and one permissive, embedded and never in :deps.
 ;; test/resources-second is a second classpath root holding the same prefix as the
 ;; first, which is how two jars carrying one migration name reach a host.
 {:test {:extra-paths ["test" "test/resources" "test/resources-second"]
         ;; ring-core is here and NOT in :deps, decided with the user 2026-09-21 (SPEC §8).
         ;; The session store implements Ring's port, so the suite needs ring to exercise
         ;; it; a consumer does not, because the namespace that requires ring is optional
         ;; and a host that wants the store brings ring itself — every host of web-base or
         ;; auth-base already has it. Measured: ring-core's closure is 1.09 MB, of which
         ;; 992 KB is commons-io, commons-codec and commons-fileupload2-core, file-upload
         ;; machinery a session store never touches; §10's whole Integrant closure is
         ;; 23,504 bytes. Rule 1 of this project is that a consumer receives a pool and a
         ;; migration runner and nothing else.
         ;; The dependency scan resolves with no alias, so it never sees this; what keeps
         ;; the arrangement honest is the subprocess guard in structure_test, because a
         ;; stray require compiles, loads and passes every other test.
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                       com.h2database/h2      {:mvn/version "2.5.250"}
                       org.xerial/sqlite-jdbc {:mvn/version "3.53.4.0"}
                       ring/ring-core         {:mvn/version "1.15.5"}}
         ;; H2's brute-force delay is JVM-global: every refused login doubles it and
         ;; the next correct login anywhere sleeps a random part of it
         ;; (org.h2.engine.Engine.validateUserAndPassword), so one test that logs in
         ;; wrongly slows whichever test connects next. It is a static final read once,
         ;; when H2 first initialises, so it has to be set before any code touches H2 —
         ;; for a test run, on the JVM's command line. Decided by a review panel over
         ;; resetting it from a test, which a pool left alive re-arms. H2 is a test
         ;; engine here; no consumer receives this.
         :jvm-opts    ["-Dh2.delayWrongPasswordMin=0"]
         :main-opts   ["-m" "cognitect.test-runner" "-d" "test"]
         :exec-fn     cognitect.test-runner.api/test}

  ;; The host of SPEC §12: a web application that wires this library and web-base, so
  ;; that "does db-base serve a consumer as it stands?" is a question with an answer.
  ;; It lives in aliases and in demo/, never in :paths or :deps: nothing a consumer of
  ;; this library receives changes because a demo exists. It is deliberately NOT on
  ;; :test either — the web stack brings a logging backend, and structure_test scans the
  ;; running classpath for exactly that. Its own run is `clojure -M:demo-test`.
  ;; web-base is consumed from Clojars like any third party's; SQLite keeps the demo
  ;; free of infrastructure, and next.jdbc is declared because the host calls it, rather
  ;; than leaning on the copy ragtime drags in (SPEC §3).
  :demo {:extra-paths ["demo/src" "demo/resources"]
         :extra-deps  {dev.arkaitz/web-base              {:mvn/version "0.2.0"}
                       org.xerial/sqlite-jdbc            {:mvn/version "3.53.4.0"}
                       com.github.seancorfield/next.jdbc {:mvn/version "1.3.1048"}
                       ch.qos.logback/logback-classic    {:mvn/version "1.6.3"}}
         :main-opts   ["-m" "demo.main"]}

  ;; The second host, and the one §12 was waiting for: a small CRUD application
  ;; on all three of these libraries at once. It lives beside `demo/` rather
  ;; than replacing it, because the two prove different things — that one is
  ;; this library with web-base and nothing else, and its cookie-contrast test
  ;; is the only place a session row is shown doing what a sealed cookie
  ;; cannot. Same rule as the first: aliases and a directory, never :paths or
  ;; :deps, and never on :test, where the web stack's logging backend would red
  ;; structure_test's classpath scan.
  ;;
  ;; auth-base comes from disk and not from Clojars on purpose: the Integrant
  ;; key and the :on-unknown hook this host needs were written for it on
  ;; 2026-09-22 and are not in 0.1.0. Consuming the sibling checkout is what
  ;; keeps that honest — a version bump would claim a release that has not
  ;; happened. next.jdbc is declared because the host calls it, rather than
  ;; leaning on the copy ragtime drags in (SPEC §3).
  :demo-tasks {:extra-paths ["demo-tasks/src" "demo-tasks/resources"]
               :extra-deps  {dev.arkaitz/web-base              {:mvn/version "0.2.0"}
                             dev.arkaitz/auth-base             {:local/root "../auth-base"}
                             org.xerial/sqlite-jdbc            {:mvn/version "3.53.4.0"}
                             com.github.seancorfield/next.jdbc {:mvn/version "1.3.1048"}
                             ch.qos.logback/logback-classic    {:mvn/version "1.6.3"}}
               :main-opts   ["-m" "demo-tasks.main"]}

  :demo-tasks-test {:extra-paths ["demo-tasks/src" "demo-tasks/resources" "demo-tasks/test"]
                    :extra-deps  {dev.arkaitz/web-base              {:mvn/version "0.2.0"}
                                  dev.arkaitz/auth-base             {:local/root "../auth-base"}
                                  org.xerial/sqlite-jdbc            {:mvn/version "3.53.4.0"}
                                  com.github.seancorfield/next.jdbc {:mvn/version "1.3.1048"}
                                  ch.qos.logback/logback-classic    {:mvn/version "1.6.3"}
                                  ring/ring-mock                    {:mvn/version "0.6.2"}
                                  io.github.cognitect-labs/test-runner
                                  {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                    :main-opts   ["-m" "cognitect.test-runner" "-d" "demo-tasks/test"]}

  ;; Two more hosts of all three libraries, 2026-09-25, built to find friction rather
  ;; than to prove a seam: one with a transaction across several tables and aggregate
  ;; reads, one with a capacity that concurrent requests must not exceed. Same rules as
  ;; the others — aliases and directories, never :paths, :deps or :test — and the same
  ;; local auth-base, for the same reason.
  :demo-ledger {:extra-paths ["demo-ledger/src" "demo-ledger/resources"]
               :extra-deps  {dev.arkaitz/web-base              {:mvn/version "0.2.0"}
                             dev.arkaitz/auth-base             {:local/root "../auth-base"}
                             org.xerial/sqlite-jdbc            {:mvn/version "3.53.4.0"}
                             com.github.seancorfield/next.jdbc {:mvn/version "1.3.1048"}
                             ch.qos.logback/logback-classic    {:mvn/version "1.6.3"}}
               :main-opts   ["-m" "demo-ledger.main"]}

  :demo-ledger-test {:extra-paths ["demo-ledger/src" "demo-ledger/resources" "demo-ledger/test"]
                    :extra-deps  {dev.arkaitz/web-base              {:mvn/version "0.2.0"}
                                  dev.arkaitz/auth-base             {:local/root "../auth-base"}
                                  org.xerial/sqlite-jdbc            {:mvn/version "3.53.4.0"}
                                  com.github.seancorfield/next.jdbc {:mvn/version "1.3.1048"}
                                  ch.qos.logback/logback-classic    {:mvn/version "1.6.3"}
                                  ring/ring-mock                    {:mvn/version "0.6.2"}
                                  io.github.cognitect-labs/test-runner
                                  {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                    :main-opts   ["-m" "cognitect.test-runner" "-d" "demo-ledger/test"]}

  :demo-events {:extra-paths ["demo-events/src" "demo-events/resources"]
               :extra-deps  {dev.arkaitz/web-base              {:mvn/version "0.2.0"}
                             dev.arkaitz/auth-base             {:local/root "../auth-base"}
                             org.xerial/sqlite-jdbc            {:mvn/version "3.53.4.0"}
                             com.github.seancorfield/next.jdbc {:mvn/version "1.3.1048"}
                             ch.qos.logback/logback-classic    {:mvn/version "1.6.3"}}
               :main-opts   ["-m" "demo-events.main"]}

  :demo-events-test {:extra-paths ["demo-events/src" "demo-events/resources" "demo-events/test"]
                    :extra-deps  {dev.arkaitz/web-base              {:mvn/version "0.2.0"}
                                  dev.arkaitz/auth-base             {:local/root "../auth-base"}
                                  org.xerial/sqlite-jdbc            {:mvn/version "3.53.4.0"}
                                  com.github.seancorfield/next.jdbc {:mvn/version "1.3.1048"}
                                  ch.qos.logback/logback-classic    {:mvn/version "1.6.3"}
                                  ring/ring-mock                    {:mvn/version "0.6.2"}
                                  io.github.cognitect-labs/test-runner
                                  {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                    :main-opts   ["-m" "cognitect.test-runner" "-d" "demo-events/test"]}

  :demo-test {:extra-paths ["demo/src" "demo/resources" "demo/test"]
              :extra-deps  {dev.arkaitz/web-base              {:mvn/version "0.2.0"}
                            org.xerial/sqlite-jdbc            {:mvn/version "3.53.4.0"}
                            com.github.seancorfield/next.jdbc {:mvn/version "1.3.1048"}
                            ch.qos.logback/logback-classic    {:mvn/version "1.6.3"}
                            ring/ring-mock                    {:mvn/version "0.6.2"}
                            io.github.cognitect-labs/test-runner
                            {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
              :main-opts   ["-m" "cognitect.test-runner" "-d" "demo/test"]}}}
