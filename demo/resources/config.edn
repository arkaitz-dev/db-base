;; The host's system. Every value here is the host's decision, not a library's: the
;; database file, the pool, how long a boot waits for another instance's migrations,
;; and the port. db-base never reads a file nobody named, and this is where it is named.
{:dev.arkaitz.db-base/database
 {:jdbc-url   "jdbc:sqlite:demo.db"
  ;; SQLite has no accounts; db-base still requires both, and never defaults them.
  :user       ""
  :password   ""
  :pool       {:max 4 :timeout-ms 5000}
  ;; A classpath prefix, not a path on disk: the migrations travel with the application,
  ;; here under demo/resources. `:lock-wait-ms` is how long this boot waits for another
  ;; instance to finish migrating before it fails and names it.
  :migrations {:dir "db-base-demo/migration" :lock-wait-ms 5000}
  ;; §8's table, asked for. Its migration runs before this host's, under a lock row of
  ;; its own, so the schema the store needs is there before anything serves.
  :sessions   {:lock-wait-ms 5000}}

 :demo/web-config {:db #ig/ref :dev.arkaitz.db-base/database
                   ;; How long a session written now is read back. The host's number and
                   ;; nobody else's: db-base will not default it, because a session that
                   ;; outlives what its host intended is the incident with no symptom.
                   ;; An hour is short enough that the demo's own expiry is visible.
                   :session-lifetime-ms 3600000
                   ;; The named opt-out for http://localhost.
                   :secure?             false}

 :dev.arkaitz.web-base/handler #ig/ref :demo/web-config

 :dev.arkaitz.web-base/server {:handler #ig/ref :dev.arkaitz.web-base/handler
                               :port    3000}}
